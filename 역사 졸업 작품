        <!-- 나중에 GitHub에 logo.png를 올리면 자동으로 표시됩니다 -->
        <img src="logo.png" alt="영훈국제중학교">

        <div class="school-name">
            YOUNGHOON<br>
            INTERNATIONAL MIDDLE SCHOOL
        </div>

    </div>

    <nav>
        <a href="#">홈</a>
